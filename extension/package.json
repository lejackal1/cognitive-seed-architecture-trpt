{
  "name": "semilla",
  "displayName": "SGC OSPOST",
  "description": "Semilla cognitiva OSPOST. Escribe en la carpeta de trabajo abierta.",
  "version": "0.1.5",
  "publisher": "sgc-ospost",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/lejackal1/cognitive-seed-architecture-trpt",
  "repository": {
    "type": "git",
    "url": "https://github.com/lejackal1/cognitive-seed-architecture-trpt"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "chatInstructions": [
      {
        "path": "./instrucciones/sgc-ospost.instructions.md"
      }
    ],
    "commands": [
      {
        "command": "sgc.activateFull",
        "title": "SGC: Activate (Full)"
      },
      {
        "command": "sgc.mostrarSalida",
        "title": "SGC: Mostrar carpetas de conocimiento"
      },
      {
        "command": "sgc.orquestarM4",
        "title": "SGC: Orquestar M4"
      }
    ],
    "configuration": {
      "title": "SGC OSPOST",
      "properties": {
        "sgc.defaultMode": {
          "type": "string",
          "enum": [
            "full",
            "off"
          ],
          "default": "full",
          "description": "Modo de la semilla. full deja activas las instrucciones mientras la extensión está habilitada."
        },
        "sgc.autoActivate": {
          "type": "boolean",
          "default": true,
          "description": "Al arrancar VS Code, marcar el contexto de modo full si defaultMode es full."
        }
      }
    }
  }
}
