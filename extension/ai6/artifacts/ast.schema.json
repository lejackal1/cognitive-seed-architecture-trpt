{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai6.dev/ast/v1/program.schema.json",
  "title": "AI6 Cognitive AST Program (Pydantic snake_case)",
  "type": "object",
  "required": [
    "program_id",
    "version",
    "profile",
    "intent_primary",
    "intent_confidence",
    "intent_source",
    "execution_state"
  ],
  "additionalProperties": false,
  "properties": {
    "program_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "const": "1.0.0" },
    "profile": { "type": "string" },
    "seed_ref": { "type": ["string", "null"] },
    "intent_primary": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "ANALYZE",
        "BUILD",
        "DOCUMENT",
        "LEARN",
        "ORCHESTRATE",
        "EVOLVE",
        "VERIFY",
        "QUERY"
      ]
    },
    "intent_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "intent_slots": { "type": "object" },
    "intent_source": {
      "type": "string",
      "enum": ["natural_language", "dsl_explicit", "replay", "trigger"]
    },
    "context": { "type": "object" },
    "goal": { "type": "object" },
    "directives": { "type": "object" },
    "body": { "type": "array", "items": { "type": "string" } },
    "pipeline": { "type": "array", "items": { "type": "string" } },
    "task_dag": { "type": "object" },
    "validation_level": {
      "type": "string",
      "enum": ["STRICT", "NORMAL", "EXPLORATORY"]
    },
    "validation_pass": { "type": ["boolean", "null"] },
    "ledger_event_id": { "type": ["string", "null"] },
    "correlation_id": { "type": ["string", "null"] },
    "execution_state": {
      "type": "string",
      "enum": [
        "parsed",
        "semantically_valid",
        "scheduled",
        "running",
        "verifying",
        "persisting",
        "completed",
        "failed",
        "rejected",
        "rolled_back"
      ]
    },
    "checkpoints": { "type": "array" }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "required": ["layer", "uri", "status"],
      "properties": {
        "layer": {
          "enum": ["view", "js", "controller", "api", "dba", "bd", "document", "other"]
        },
        "uri": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "status": { "enum": ["CONFIRMED", "PARTIAL", "UNCONFIRMED"] }
      }
    }
  }
}
